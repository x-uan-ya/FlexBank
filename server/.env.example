# FlexBank Concierge proxy — environment template.
# Copy to `.env` and fill in. NEVER commit your real .env.

# Your Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
# This stays SERVER-SIDE only. It must never appear in the Expo app or EXPO_PUBLIC_* vars.
GEMINI_API_KEY=

# Free-tier model. gemini-2.5-flash-lite has the highest free quota; good for
# short banking Q&A. gemini-2.5-flash is also free (lower RPM/day). Do NOT use
# Pro (not free for most accounts).
GEMINI_MODEL=gemini-2.5-flash-lite

# Port the proxy listens on.
PORT=8787

# Comma-separated allowed origins for CORS. Leave as * for local dev only.
CORS_ORIGIN=*
