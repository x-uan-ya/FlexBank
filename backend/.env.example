# Copy this file to ".env" and fill it in. NEVER commit the ".env" file.

PORT=4000

# Any long random string (16+ characters). Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed to call the server (the Expo web app). Native apps are not affected.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Demo control: reset the demo data. Leave empty to disable it completely.
DEMO_KEY=
